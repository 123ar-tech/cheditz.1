rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /cheditz/{doc} {
      allow read, write: if true;
    }
    match /cheditz_orders/{doc} {
      allow read, write: if true;
    }
    match /cheditz_receipts/{doc} {
      allow read, write: if true;
    }
    match /cheditz_testimonials/{doc} {
      allow read, write: if true;
    }
    match /cheditz_push_subs/{doc} {
      allow read, write: if true;
    }
    match /cheditz_agent_log/{doc} {
      allow read, write: if true;
    }
  }
}
